{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    // DOM for the page.evaluate() callbacks, which run inside Obsidian.
    "lib": ["DOM", "ES2022"],
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
