{
  "name": "taskchute-plus",
  "version": "2.2.15",
  "description": "TaskChute Plus Plugin for Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:unit": "jest --testPathIgnorePatterns \"/node_modules/\" \"\\.integration\\.test\\.\"",
    "test:integration": "jest --testPathPatterns \"\\.integration\\.test\\.\"",
    "test:watch": "jest --watch --testPathIgnorePatterns \"/node_modules/\" \"\\.integration\\.test\\.\"",
    "test:coverage": "jest --coverage --testPathIgnorePatterns \"/node_modules/\" \"\\.integration\\.test\\.\"",
    "prepare": "husky",
    "lint": "eslint --config eslint.config.mjs \"src/**/*.{ts,tsx,js}\" \"tests/**/*.{ts,tsx,js}\"",
    "lint:staged": "node scripts/lint-staged.mjs",
    "review:obsidian": "node scripts/obsidian-review.mjs"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/css": "^1.4.0",
    "@eslint/js": "^9.36.0",
    "@lezer/highlight": "^1.2.3",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.8.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.36.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "moment": "^2.30.1",
    "obsidian": "^1.13.1",
    "ts-jest": "^29.4.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.68.0",
    "yaml": "^2.9.0"
  }
}
